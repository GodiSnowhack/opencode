 1168 | |   
 1169 | |         let permission
 1170 | |         try {
 1171 | |           const response = await octoRest.repos.getCollaboratorPermissionLevel({
 1172 | |             owner,
 1173 | |             repo,
 1174 | |             username: actor!,
 1175 | |           })
 1176 | |   
 1177 | |           permission = response.data.permission
 1178 | |           console.log(`  permission: ${permission}`)
 1179 | |         } catch (error) {
 1180 | |           console.error(`Failed to check permissions: ${error}`)
 1181 | |           throw new Error(`Failed to check permissions for user ${actor}: ${error}`, { cause: error })
 1182 | |         }
 1183 | |   
 1184 | |         if (!["admin", "write"].includes(permission)) throw new Error(`User ${actor} does not have write permissions`)
 1185 | |       }
